				{
					"name": "Create Campaign",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"title\": \"Help Build a Community Center\",\n  \"description\": \"We are raising funds to build a community center for underprivileged children\",\n  \"goal_amount\": 50000,\n  \"category\": \"community\",\n  \"end_date\": \"2025-06-30T23:59:59Z\",\n  \"images\": [\n    \"https://example.com/image1.jpg\",\n    \"https://example.com/image2.jpg\"\n  ],\n  \"video_url\": \"https://youtube.com/example\",\n  \"location\": {\n    \"city\": \"Lagos\",\n    \"state\": \"Lagos\",\n    \"country\": \"Nigeria\"\n  },\n  \"beneficiary_info\": {\n    \"name\": \"Community Trust Foundation\",\n    \"contact\": \"+234XXXXXXXXXX\"\n  }\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/v1/crowdfunding/campaign",
							"host": ["{{base_url}}"],
							"path": ["api", "v1", "crowdfunding", "campaign"]
						},
						"description": "Create a new crowdfunding campaign. Requires authentication."
					},
					"response": []
